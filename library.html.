
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#100d19">
<title>Ma bibliothèque — Novelia</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#100d19;color:#f8f5ff;font-family:Arial,sans-serif}
header{padding:18px;background:#191324;border-bottom:1px solid #39284c}
a{color:#c4a5ff;text-decoration:none}
main{max-width:850px;margin:auto;padding:20px 16px}
h1{color:#c4a5ff}
nav{display:flex;gap:18px;flex-wrap:wrap;margin-top:12px}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:22px 0}
button{padding:10px 13px;border:1px solid #49345f;border-radius:9px;background:#211630;color:white;cursor:pointer}
button.active{background:#8b5cf6}
.item{padding:14px;margin:12px 0;background:#191324;border:1px solid #39284c;border-radius:12px}
.item h3{margin:0 0 8px}
.item p{color:#c7b8da;font-size:14px}
.open{display:inline-block;margin-top:8px;padding:9px 12px;background:#8b5cf6;border-radius:8px;color:white}
#message{color:#c4a5ff;line-height:1.6}
</style>
</head>
<body>
<header>
  <strong>✦ NOVELIA</strong>
  <nav>
    <a href="index.html">Accueil</a>
    <a href="profile.html">Mon profil</a>
    <a href="publish.html">Publier</a>
  </nav>
</header>

<main>
  <h1>Ma bibliothèque</h1>
  <p>Retrouve tes lectures et tes histoires favorites.</p>

  <div class="tabs">
    <button class="active" data-view="favorites">Mes favoris</button>
    <button data-view="history">Historique de lecture</button>
  </div>

  <p id="message">Chargement de ta bibliothèque…</p>
  <section id="list"></section>
</main>

<script type="module">
import { createClient } from
"https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm";

const supabase = createClient(
  "https://czwaokqpqgrghxeeyguq.supabase.co",
  "sb_publishable_ORoXM7DSfxdLF0jz8JRqqA_SISXCNsg"
);

const $ = id => document.getElementById(id);
let view = "favorites";
let library = [];
let history = [];
let databaseStories = {};
const demoNames = {
  roses: "Les Roses de minuit",
  lune: "La Lune des oubliés",
  automne: "Un automne pour nous",
  ville: "La Ville sans ombre"
};

function safeText(tag, text) {
  const el = document.createElement(tag);
  el.textContent = text ?? "";
  return el;
}

function storyLink(key) {
  if (key.startsWith("db_")) {
    return "reader.html?db_story=" +
      encodeURIComponent(key.slice(3));
  }
  return "reader.html?story=" + encodeURIComponent(key);
}

function storyName(key) {
  if (key.startsWith("db_")) {
    return databaseStories[key.slice(3)]?.title
      || "Histoire publiée sur Novelia";
  }
  return demoNames[key] || "Histoire Novelia";
}

function render() {
  const list = $("list");
  list.replaceChildren();

  const keys = view === "favorites"
    ? library.filter(x => x.is_favorite).map(x => x.story_key)
    : history.map(x => x.story_key);

  const uniqueKeys = [...new Set(keys)];

  if (!uniqueKeys.length) {
    $("message").textContent = view === "favorites"
      ? "Tes favoris apparaîtront ici lorsque tu en ajouteras."
      : "Ton historique apparaîtra ici après tes lectures.";
    return;
  }

  $("message").textContent = "";

  uniqueKeys.forEach(key => {
    const item = document.createElement("article");
    item.className = "item";
    item.appendChild(safeText("h3", storyName(key)));

    const record = history.find(x => x.story_key === key);
    if (view === "history" && record) {
      item.appendChild(safeText("p",
        "Dernier chapitre consulté : " + record.last_chapter));
      item.appendChild(safeText("p",
        "Dernière lecture : " +
        new Date(record.last_read_at).toLocaleDateString("fr-FR")));
    }

    const link = document.createElement("a");
    link.className = "open";
    link.href = storyLink(key);
    link.textContent = view === "history"
      ? "Reprendre la lecture" : "Ouvrir l'histoire";
    item.appendChild(link);
    list.appendChild(item);
  });
}

async function loadLibrary() {
  const { data: auth } = await supabase.auth.getUser();
  const user = auth.user;

  if (!user) {
    $("message").textContent =
      "Connecte-toi pour accéder à ta bibliothèque.";
    const link = document.createElement("a");
    link.href = "login.html";
    link.className = "open";
    link.textContent = "Se connecter";
    $("list").replaceChildren(link);
    return;
  }

  const [libResult, historyResult] = await Promise.all([
    supabase.from("user_library")
      .select("story_key,is_favorite,last_chapter")
      .eq("user_id", user.id),
    supabase.from("reading_history")
      .select("story_key,last_chapter,last_read_at")
      .eq("user_id", user.id)
      .order("last_read_at", { ascending: false })
  ]);

  if (libResult.error || historyResult.error) {
    $("message").textContent =
      "Impossible de charger la bibliothèque. " +
      (libResult.error?.message || historyResult.error?.message);
    return;
  }

  library = libResult.data || [];
  history = historyResult.data || [];

  const keys = [...new Set([
    ...library.map(x => x.story_key),
    ...history.map(x => x.story_key)
  ])];

  const ids = keys
    .filter(key => key.startsWith("db_"))
    .map(key => key.slice(3))
    .filter(id => /^[0-9a-f-]{36}$/i.test(id));

  if (ids.length) {
    const { data, error } = await supabase
      .from("stories")
      .select("id,title")
      .in("id", ids);

    if (!error) {
      (data || []).forEach(story => {
        databaseStories[story.id] = story;
      });
    }
  }

  render();
}

document.querySelectorAll("[data-view]").forEach(button => {
  button.addEventListener("click", () => {
    view = button.dataset.view;
    document.querySelectorAll("[data-view]").forEach(b =>
      b.classList.toggle("active", b === button)
    );
    render();
  });
});

loadLibrary();
</script>
</body>
</html>
